@model Producto

@{
    ViewData["Title"] = "Crear Producto";
}

<div class="container-fluid px-0">

    <!-- Encabezado -->
    <div class="d-flex align-items-center mb-4">

        <div class="page-header-icon me-3">
            <i class="bi bi-plus-circle"></i>
        </div>

        <div>
            <h1 class="h2 fw-bold mb-1 page-title">
                Crear Producto
            </h1>

            <p class="text-muted mb-0">
                Completá los datos del nuevo producto.
            </p>
        </div>

    </div>

    <!-- Formulario -->
    <div class="row">

        <div class="col-12 col-lg-6">

            <div class="card border-0 shadow-sm form-card">

                <div class="card-body p-4">

                    <form asp-action="Create" method="post">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <!-- Código -->
<div class="mb-3">

    <label asp-for="Codigo"
           class="form-label">
    </label>

    <input asp-for="Codigo"
           class="form-control"
           placeholder="Opcional. Ej: PRD-001" />

    <span asp-validation-for="Codigo"
          class="text-danger small">
    </span>

</div>

                        <!-- Nombre -->
                        <div class="mb-3">

                            <label asp-for="Nombre"
                                   class="form-label">
                            </label>

                            <input asp-for="Nombre"
                                   class="form-control"
                                   placeholder="Nombre del producto" />

                            <span asp-validation-for="Nombre"
                                  class="text-danger small">
                            </span>

                        </div>

                        <!-- Unidad de medida -->
<div class="mb-3">

    <label asp-for="UnidadMedida"
           class="form-label">
    </label>

    <select asp-for="UnidadMedida"
            asp-items="ViewBag.Unidades"
            class="form-select">
    </select>

    <span asp-validation-for="UnidadMedida"
          class="text-danger small">
    </span>

</div>

                        <!-- Precio -->
                        <div class="mb-4">

                            <label asp-for="PrecioUnitario"
                                   class="form-label">
                            </label>

                            <input asp-for="PrecioUnitario"
                                   class="form-control"
                                   type="number"
                                   step="0.01"
                                   min="0.01"
                                   placeholder="0.00" />

                            <span asp-validation-for="PrecioUnitario"
                                  class="text-danger small">
                            </span>

                        </div>

                        <!-- Botones -->
                        <div class="d-flex flex-column flex-sm-row gap-2 form-actions">

                            <button type="submit"
                                    class="btn btn-primary px-4">
                                <i class="bi bi-check-circle me-1"></i>
                                Crear Producto
                            </button>

                            <a asp-action="Index"
                               class="btn btn-outline-secondary px-4">
                                <i class="bi bi-x-circle me-1"></i>
                                Cancelar
                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}