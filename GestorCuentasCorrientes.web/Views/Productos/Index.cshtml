@model List<Producto>

@{
    ViewData["Title"] = "Productos";
}

<div class="container-fluid px-0">

    <!-- Encabezado -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4">

        <div class="d-flex align-items-center">

            <div class="page-header-icon me-3">
                <i class="bi bi-box-seam"></i>
            </div>

            <div>
                <h1 class="h2 fw-bold mb-1 page-title">
                    Productos
                </h1>

                <p class="text-muted mb-0">
                    Administración de productos y precios.
                </p>
            </div>

        </div>

        <div class="mt-3 mt-md-0">
            <a asp-action="Create"
               class="btn btn-primary px-4 shadow-sm">
                <i class="bi bi-plus-circle me-1"></i>
                Nuevo Producto
            </a>
        </div>

    </div>

    <!-- Filtros -->
    <div class="card border-0 shadow-sm mb-4 surface-card filter-card">

        <div class="card-body p-4">

            <div class="d-flex align-items-center mb-3">

                <div class="filter-icon me-2">
                    <i class="bi bi-funnel fs-5"></i>
                </div>

                <div>
                    <h2 class="h6 fw-bold mb-0">
                        Buscar productos
                    </h2>

                    <small class="text-muted">
                        Utiliza el filtro para encontrar un producto.
                    </small>
                </div>

            </div>

            <form method="get" class="row g-3">

                <div class="col-12 col-md-6">
                    <input type="text"
                           name="searchTerm"
                           class="form-control"
                           placeholder="Nombre del producto..."
                           value="@ViewBag.SearchTerm">
                </div>

                <div class="col-12 col-md-auto d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-search me-1"></i>
                        Buscar
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-x-circle me-1"></i>
                        Limpiar
                    </a>
                </div>

            </form>

        </div>

    </div>

    <!-- Tabla de Productos -->
    <div class="card border-0 shadow-sm surface-card">

        <div class="card-body p-0">

            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">

                    <table class="table table-products mb-0">

                        <thead>
                            <tr>
                                <th scope="col" class="px-4 py-3">Producto</th>
                                <th scope="col" class="px-4 py-3 text-end">Precio Unitario</th>
                                <th scope="col" class="px-4 py-3">Estado</th>
                                <th scope="col" class="px-4 py-3 text-end">Acciones</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var producto in Model)
                            {
                                <tr class="@(producto.Activo ? "" : "row-inactive")">
                                    <td class="px-4 py-3">
                                        <div class="d-flex align-items-center">
                                            <div class="product-avatar me-3">
                                                <i class="bi bi-box"></i>
                                            </div>
                                            <span class="product-name">@producto.Nombre</span>
                                        </div>
                                    </td>

                                    <td class="px-4 py-3 text-end">
                                        <span class="product-price">@producto.PrecioUnitario.ToString("C")</span>
                                    </td>

                                    <td class="px-4 py-3">
                                        @if (producto.Activo)
                                        {
                                            <span class="status-pill status-pill--active">Activo</span>
                                        }
                                        else
                                        {
                                            <span class="status-pill status-pill--inactive">Inactivo</span>
                                        }
                                    </td>

                                    <td class="px-4 py-3">
                                        <div class="action-buttons justify-content-end">

                                            <a asp-action="Edit"
                                               asp-route-id="@producto.Id"
                                               class="btn btn-sm btn-outline-primary btn-icon"
                                               title="Editar">
                                                <i class="bi bi-pencil"></i>
                                            </a>

                                            <form asp-action="CambiarEstado"
                                                  asp-route-id="@producto.Id"
                                                  method="post"
                                                  style="display:inline;">
                                                @if (producto.Activo)
                                                {
                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-warning btn-icon"
                                                            title="Desactivar"
                                                            onclick="return confirm('¿Desactivar este producto?');">
                                                        <i class="bi bi-dash-circle"></i>
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-success btn-icon"
                                                            title="Activar"
                                                            onclick="return confirm('¿Activar este producto?');">
                                                        <i class="bi bi-check-circle"></i>
                                                    </button>
                                                }
                                            </form>

                                        </div>
                                    </td>

                                </tr>
                            }
                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="alert alert-info m-4">
                    <i class="bi bi-info-circle me-2"></i>
                    No se encontraron productos.
                </div>
            }

        </div>

    </div>

</div>