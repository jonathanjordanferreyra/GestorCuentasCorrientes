@using GestorCuentasCorrientes.web.Models
@model GestorCuentasCorrientes.web.Models.ViewModels.PresupuestoCreateVm

@{
    ViewData["Title"] = Model.Id.HasValue ? "Editar Presupuesto" : "Nuevo Presupuesto";

    var productos = (IEnumerable<Producto>)ViewBag.Productos;
}

<div class="container-fluid px-0">

    <!-- Encabezado -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4">

        <div class="d-flex align-items-center">

            <div class="page-header-icon me-3">
                <i class="bi bi-plus-circle"></i>
            </div>

            <div>
                <h1 class="h2 fw-bold mb-1 page-title">
    @ViewData["Title"]
</h1>

                <p class="text-muted mb-0">
                    Elegí el cliente y cargá los conceptos a presupuestar.
                </p>
            </div>

        </div>

        <div class="mt-3 mt-md-0">

            <a asp-controller="Clientes"
               asp-action="Index"
               class="btn btn-outline-secondary px-4">
                <i class="bi bi-arrow-left me-1"></i>
                Volver
            </a>

        </div>

    </div>

    <form asp-action="@(Model.Id.HasValue ? "Edit" : "Create")"
      asp-route-id="@Model.Id"
      method="post">

    @Html.AntiForgeryToken()

    <input type="hidden" asp-for="Id" />

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3">
        </div>

        <!-- DATOS GENERALES -->

        <div class="card border-0 shadow-sm section-card mb-4">

            <div class="card-header">
                <h2 class="section-title">
                    <i class="bi bi-info-circle"></i>
                    Datos del presupuesto
                </h2>
            </div>

            <div class="card-body p-4">

                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label asp-for="ClienteId"
                               class="form-label">
                        </label>

                        <select asp-for="ClienteId"
                                asp-items="ViewBag.ClienteId"
                                class="form-select">

                            <option value="">
                                -- Seleccione un cliente --
                            </option>

                        </select>

                        <span asp-validation-for="ClienteId"
                              class="text-danger small">
                        </span>

                    </div>

                    <div class="col-md-3 mb-3">

                        <label asp-for="Fecha"
                               class="form-label">
                        </label>

                        <input asp-for="Fecha"
                               class="form-control" />

                        <span asp-validation-for="Fecha"
                              class="text-danger small">
                        </span>

                    </div>
                    <div class="col-md-3 mb-3">

    <label asp-for="DiasValidez"
           class="form-label">
    </label>

    <div class="input-group">

        <input asp-for="DiasValidez"
               type="number"
               min="1"
               max="365"
               class="form-control" />

        <span class="input-group-text">días</span>

    </div>

    <span asp-validation-for="DiasValidez"
          class="text-danger small">
    </span>

</div>

                </div>

                <div class="mb-0">

                    <label asp-for="Observaciones"
                           class="form-label">
                    </label>

                    <textarea asp-for="Observaciones"
                              class="form-control"
                              rows="3">
                    </textarea>

                    <span asp-validation-for="Observaciones"
                          class="text-danger small">
                    </span>

                </div>

            </div>

        </div>

        <!-- CONCEPTOS -->

        <div class="card border-0 shadow-sm section-card mb-4">

            <div class="card-header d-flex justify-content-between align-items-center">

                <h2 class="section-title">
                    <i class="bi bi-list-ul"></i>
                    Conceptos
                </h2>

                <button type="button"
                        id="btnAgregarDetalle"
                        class="btn btn-primary btn-sm px-3">

                    <i class="bi bi-plus-lg me-1"></i>
                    + Agregar concepto

                </button>

            </div>

            <div class="card-body p-0">

                <div asp-validation-for="Detalles"
                     class="text-danger px-4 pt-3">
                </div>

                <div class="table-responsive">

                    <table class="table table-products table-detalles align-middle mb-0">

                        <thead>

                            <tr>

                                <th style="width: 40%">
                                    Producto
                                </th>

                                <th style="width: 15%">
                                    Cantidad
                                </th>

                                <th style="width: 20%">
                                    Precio Unitario
                                </th>

                                <th style="width: 15%" class="text-end">
                                    Subtotal
                                </th>

                                <th style="width: 10%">
                                </th>

                            </tr>

                        </thead>

                        <tbody id="detallesContainer">

                            @for (int i = 0; i < Model.Detalles.Count; i++)
                            {
                                <tr class="detalle-row">

                                    <td>

                                        <select name="Detalles[@i].ProductoId"
                                                class="form-select producto">

                                            <option value="">
                                                -- Seleccione un producto --
                                            </option>

                                            @foreach (var producto in productos)
                                            {
                                                <option value="@producto.Id"
                                                        data-precio="@producto.PrecioUnitario.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                                        selected="@(producto.Id == Model.Detalles[i].ProductoId ? "selected" : null)">
                                                    @producto.Nombre
                                                </option>
                                            }

                                        </select>

                                    </td>

                                    <td>

                                        <input type="number"
                                               name="Detalles[@i].Cantidad"
                                               value="@Model.Detalles[i].Cantidad.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                               class="form-control cantidad"
                                               min="0.01"
                                               step="0.001" />

                                    </td>

                                    <td>

                                        <input type="text"
                                               class="form-control precio"
                                               value="0,00"
                                               readonly />

                                    </td>

                                    <td>

                                        <span class="subtotal">
                                            $0,00
                                        </span>

                                    </td>

                                    <td class="text-center">

                                        <button type="button"
                                                class="btn btn-danger btn-sm btnEliminarDetalle">

                                            Eliminar

                                        </button>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

                <div class="text-end p-4">

                    <div class="total-box">

                        <span class="total-label">Total</span>

                        <h4 class="mb-0">
                            <span id="totalPresupuesto">
                                $0,00
                            </span>
                        </h4>

                    </div>

                </div>

            </div>

        </div>

        <!-- BOTONES -->

        <div class="d-flex flex-column-reverse flex-sm-row justify-content-end gap-2">

            <a asp-controller="Presupuestos"
   asp-action="@(Model.Id.HasValue ? "Details" : "Index")"
   asp-route-id="@Model.Id"
   class="btn btn-outline-secondary px-4">

    <i class="bi bi-x-circle me-1"></i>
    Cancelar

</a>

            <button type="submit"
                    class="btn btn-success px-4">

                <i class="bi bi-check-circle me-1"></i>
                @(Model.Id.HasValue ? "Guardar cambios" : "Guardar presupuesto")

            </button>

        </div>

    </form>

</div>

<!--
    Plantilla de opciones de productos.
    Se utiliza para crear nuevas filas mediante JavaScript.
-->
<template id="opcionesProductos">

    <option value="">
        -- Seleccione un producto --
    </option>

    @foreach (var producto in productos)
    {
        <option value="@producto.Id"
                data-precio="@producto.PrecioUnitario.ToString(System.Globalization.CultureInfo.InvariantCulture)">
            @producto.Nombre
        </option>
    }

</template>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        // ------------------------------------------------------------
        // Actualiza los índices de los elementos del formulario
        // ------------------------------------------------------------

        function actualizarIndices() {

            const filas =
                document.querySelectorAll(".detalle-row");

            filas.forEach((fila, index) => {

                fila.querySelectorAll(
                    "input, select"
                ).forEach(elemento => {

                    const name =
                        elemento.getAttribute("name");

                    if (!name)
                        return;

                    const nuevoName =
                        name.replace(
                            /Detalles\[\d+\]/,
                            `Detalles[${index}]`
                        );

                    elemento.setAttribute(
                        "name",
                        nuevoName
                    );

                });

            });
        }


        // ------------------------------------------------------------
        // Obtiene el precio del producto seleccionado
        // ------------------------------------------------------------

        function obtenerPrecio(fila) {

            const select =
                fila.querySelector(".producto");

            const precioInput =
                fila.querySelector(".precio");

            if (!select || !precioInput)
                return 0;

            const opcionSeleccionada =
                select.options[select.selectedIndex];

            if (!opcionSeleccionada)
                return 0;

            const precio =
                parseFloat(
                    opcionSeleccionada.dataset.precio
                ) || 0;

            precioInput.value =
                precio.toLocaleString(
                    "es-AR",
                    {
                        minimumFractionDigits: 2,
                        maximumFractionDigits: 2
                    }
                );

            return precio;
        }


        // ------------------------------------------------------------
        // Actualiza precio y subtotal de una fila
        // ------------------------------------------------------------

        function actualizarFila(fila) {

            const select =
                fila.querySelector(".producto");

            const cantidadInput =
                fila.querySelector(".cantidad");

            const precioInput =
                fila.querySelector(".precio");

            const subtotalElemento =
                fila.querySelector(".subtotal");

            if (!select ||
                !cantidadInput ||
                !precioInput ||
                !subtotalElemento)
                return;

            const opcionSeleccionada =
                select.options[select.selectedIndex];

            let precio = 0;

            if (opcionSeleccionada) {

                precio =
                    parseFloat(
                        opcionSeleccionada.dataset.precio
                    ) || 0;

            }

            const cantidad =
                parseFloat(
                    cantidadInput.value
                ) || 0;

            precioInput.value =
                precio.toLocaleString(
                    "es-AR",
                    {
                        minimumFractionDigits: 2,
                        maximumFractionDigits: 2
                    }
                );

            const subtotal =
                cantidad * precio;

            subtotalElemento.textContent =
                subtotal.toLocaleString(
                    "es-AR",
                    {
                        style: "currency",
                        currency: "ARS"
                    }
                );
        }


        // ------------------------------------------------------------
        // Actualiza todos los subtotales y el total general
        // ------------------------------------------------------------

        function actualizarTotales() {

            let total = 0;

            document
                .querySelectorAll(".detalle-row")
                .forEach(fila => {

                    actualizarFila(fila);

                    const cantidadInput =
                        fila.querySelector(".cantidad");

                    const select =
                        fila.querySelector(".producto");

                    const cantidad =
                        parseFloat(
                            cantidadInput?.value
                        ) || 0;

                    const opcionSeleccionada =
                        select?.options[
                            select.selectedIndex
                        ];

                    const precio =
                        parseFloat(
                            opcionSeleccionada?.dataset.precio
                        ) || 0;

                    total += cantidad * precio;

                });

            document.getElementById(
                "totalPresupuesto"
            ).textContent =
                total.toLocaleString(
                    "es-AR",
                    {
                        style: "currency",
                        currency: "ARS"
                    }
                );
        }


        // ------------------------------------------------------------
        // Agregar nuevo concepto
        // ------------------------------------------------------------

        document.getElementById(
            "btnAgregarDetalle"
        ).addEventListener(
            "click",
            function () {

                const container =
                    document.getElementById(
                        "detallesContainer"
                    );

                const index =
                    container.querySelectorAll(
                        ".detalle-row"
                    ).length;

                const fila =
                    document.createElement("tr");

                fila.classList.add(
                    "detalle-row"
                );

                fila.innerHTML = `

                    <td>

                        <select name="Detalles[${index}].ProductoId"
                                class="form-select producto">

                            ${document.getElementById("opcionesProductos").innerHTML}

                        </select>

                    </td>

                    <td>

                        <input type="number"
                               name="Detalles[${index}].Cantidad"
                               class="form-control cantidad"
                               value="1"
                               min="0.01"
                               step="0.001" />

                    </td>

                    <td>

                        <input type="text"
                               class="form-control precio"
                               value="0,00"
                               readonly />

                    </td>

                    <td>

                        <span class="subtotal">
                            $0,00
                        </span>

                    </td>

                    <td class="text-center">

                        <button type="button"
                                class="btn btn-danger btn-sm btnEliminarDetalle">

                            Eliminar

                        </button>

                    </td>

                `;

                container.appendChild(fila);

                actualizarIndices();
                actualizarTotales();

            }
        );


        // ------------------------------------------------------------
        // Eliminar concepto
        // ------------------------------------------------------------

        document.addEventListener(
            "click",
            function (e) {

                if (!e.target.classList.contains(
                    "btnEliminarDetalle"
                ))
                    return;

                const filas =
                    document.querySelectorAll(
                        ".detalle-row"
                    );

                if (filas.length <= 1) {

                    alert(
                        "El presupuesto debe tener al menos un concepto."
                    );

                    return;
                }

                e.target
                    .closest(".detalle-row")
                    .remove();

                actualizarIndices();
                actualizarTotales();

            }
        );


        // ------------------------------------------------------------
        // Cambio de producto
        // ------------------------------------------------------------

        document.addEventListener(
            "change",
            function (e) {

                if (
                    e.target.classList.contains(
                        "producto"
                    )
                ) {

                    const fila =
                        e.target.closest(
                            ".detalle-row"
                        );

                    if (fila) {

                        actualizarFila(fila);
                        actualizarTotales();

                    }

                }

            }
        );


        // ------------------------------------------------------------
        // Cambio de cantidad
        // ------------------------------------------------------------

        document.addEventListener(
            "input",
            function (e) {

                if (
                    e.target.classList.contains(
                        "cantidad"
                    )
                ) {

                    actualizarTotales();

                }

            }
        );


        // ------------------------------------------------------------
        // Inicialización
        // ------------------------------------------------------------

        document.addEventListener(
            "DOMContentLoaded",
            function () {

                actualizarTotales();

            }
        );

    </script>
}