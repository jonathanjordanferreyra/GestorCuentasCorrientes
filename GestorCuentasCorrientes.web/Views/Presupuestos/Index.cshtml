@model IEnumerable<GestorCuentasCorrientes.web.Models.Presupuesto>

@{
    ViewData["Title"] = "Presupuestos";
}

<div class="container-fluid px-0">

    <!-- Encabezado -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4">

        <div class="d-flex align-items-center">

            <div class="page-header-icon me-3">
                <i class="bi bi-file-earmark-text"></i>
            </div>

            <div>
                <h1 class="h2 fw-bold mb-1 page-title">
                    Presupuestos
                </h1>

                <p class="text-muted mb-0">
                    Listado de presupuestos emitidos a clientes.
                </p>
            </div>

        </div>

        <div class="mt-3 mt-md-0">

            <a asp-controller="Presupuestos"
               asp-action="Create"
               class="btn btn-primary px-4 shadow-sm">
                <i class="bi bi-plus-circle me-1"></i>
                + Nuevo presupuesto
            </a>

        </div>

    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle me-2"></i>
            No hay presupuestos registrados.
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm surface-card">

            <div class="card-body p-0">

                <div class="table-responsive">

                    <table class="table table-products align-middle mb-0">

                        <thead>

                            <tr>

                                <th class="px-4 py-3">
                                    N.º
                                </th>

                                <th class="px-4 py-3">
                                    Fecha
                                </th>

                                <th class="px-4 py-3">
                                    Cliente
                                </th>

                                <th class="px-4 py-3">
                                    Estado
                                </th>

                                <th class="px-4 py-3 text-end">
                                    Total
                                </th>

                                <th class="px-4 py-3 text-center">
                                    Acciones
                                </th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var presupuesto in Model)
                            {
                                var total = presupuesto.Detalles
                                    .Sum(d =>
                                        d.Cantidad *
                                        d.PrecioUnitario);

                                <tr>

                                    <td class="px-4 py-3">
                                        <span class="doc-number">
                                            @presupuesto.Id
                                        </span>
                                    </td>

                                    <td class="px-4 py-3 text-nowrap">
                                        @presupuesto.Fecha.ToString("dd/MM/yyyy")
                                    </td>

                                    <td class="px-4 py-3">
                                        <div class="client-cell">
                                            <i class="bi bi-person-circle"></i>
                                            <span>@presupuesto.Cliente?.RazonSocial</span>
                                        </div>
                                    </td>

                                    <td class="px-4 py-3">

                                        @if (presupuesto.Estado == "Aprobado")
                                        {
                                            <span class="status-pill status-pill--active">
                                                Aceptado
                                            </span>
                                        }
                                        else if (presupuesto.Estado == "Rechazado")
                                        {
                                            <span class="status-pill status-pill--inactive">
                                                Rechazado
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="status-pill status-pill--neutral">
                                                @presupuesto.Estado
                                            </span>
                                        }

                                    </td>

                                    <td class="px-4 py-3 text-end">

                                        <span class="product-price">
                                            @total.ToString("C2")
                                        </span>

                                    </td>

                                    <td class="px-4 py-3 text-center">

                                        <a asp-controller="Presupuestos"
                                           asp-action="Details"
                                           asp-route-id="@presupuesto.Id"
                                           class="btn btn-sm btn-outline-primary px-3">

                                            <i class="bi bi-eye me-1"></i>
                                            Ver

                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>
    }

</div>