@model GestorCuentasCorrientes.web.Models.Presupuesto

@{
    ViewData["Title"] = "Detalle del Presupuesto";

    var estadoClase = Model.Estado == "Aceptado" ? "status-pill--active"
                    : Model.Estado == "Rechazado" ? "status-pill--inactive"
                    : "status-pill--neutral";
}

<div class="container-fluid px-0">

    <!-- Encabezado -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4">

        <div class="d-flex align-items-center">

            <div class="page-header-icon me-3">
                <i class="bi bi-file-earmark-text"></i>
            </div>

            <div>

                <h1 class="h2 fw-bold mb-2 page-title">
                    Presupuesto N.º @Model.Id
                </h1>

                <span class="status-pill @estadoClase">
                    @Model.Estado
                </span>

            </div>

        </div>

        <div class="d-flex flex-column flex-sm-row gap-2 mt-3 mt-md-0">

            <a asp-controller="Presupuestos"
               asp-action="Pdf"
               asp-route-id="@Model.Id"
               class="btn btn-danger px-4 shadow-sm">
                <i class="bi bi-file-earmark-pdf me-1"></i>
                Descargar PDF
            </a>

            <a asp-controller="Clientes"
               asp-action="Details"
               asp-route-id="@Model.ClienteId"
               class="btn btn-outline-secondary px-4">
                <i class="bi bi-arrow-left me-1"></i>
                Volver al cliente
            </a>

        </div>

    </div>


    <!-- DATOS GENERALES -->

    <div class="card border-0 shadow-sm section-card mb-4">

        <div class="card-header">
            <h2 class="section-title">
                <i class="bi bi-info-circle"></i>
                Datos del presupuesto
            </h2>
        </div>

        <div class="card-body p-4">

            <div class="row g-4">

                <div class="col-md-4">

                    <div class="info-label">Número</div>

                    <p class="info-value">
                        @Model.Id
                    </p>

                </div>

                <div class="col-md-4">

                    <div class="info-label">Fecha</div>

                    <p class="info-value">
                        @Model.Fecha.ToString("dd/MM/yyyy")
                    </p>

                </div>

                <div class="col-md-4">

                    <div class="info-label">Cliente</div>

                    <p class="info-value">
                        @Model.Cliente?.RazonSocial
                    </p>

                </div>

                <div class="col-md-6">

                    <div class="info-label">Usuario</div>

                    <p class="info-value">
                        @Model.Usuario?.Nombre
                        @Model.Usuario?.Apellido
                    </p>

                </div>

                <div class="col-md-6">

                    <div class="info-label">Fecha de registro</div>

                    <p class="info-value">
                        @Model.FechaRegistro.ToString("dd/MM/yyyy HH:mm")
                    </p>

                </div>

            </div>


            @if (!string.IsNullOrWhiteSpace(Model.Observaciones))
            {
                <div class="mt-4">

                    <div class="info-label">Observaciones</div>

                    <div class="info-notes">
                        <p class="info-value info-multiline mb-0">
                            @Model.Observaciones
                        </p>
                    </div>

                </div>
            }

        </div>

    </div>


    <!-- CONCEPTOS -->

    <div class="card border-0 shadow-sm section-card">

        <div class="card-header">

            <h2 class="section-title">
                <i class="bi bi-list-ul"></i>
                Conceptos
            </h2>

        </div>

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-products table-detalles table-totals align-middle mb-0">

                    <thead>

                        <tr>

                            <th>
                                #
                            </th>

                            <th>
                                Descripción
                            </th>

                            <th class="text-end">
                                Cantidad
                            </th>

                            <th class="text-end">
                                Precio Unitario
                            </th>

                            <th class="text-end">
                                Subtotal
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @{
                            decimal total = 0;
                            int numeroLinea = 1;
                        }

                        @foreach (var detalle in Model.Detalles)
                        {
                            var subtotal =
                                detalle.Cantidad *
                                detalle.PrecioUnitario;

                            total += subtotal;

                            <tr>

                                <td class="text-muted">
                                    @numeroLinea
                                </td>

                                <td class="fw-semibold">
                                    @detalle.Descripcion
                                </td>

                                <td class="text-end">
                                    @detalle.Cantidad
                                </td>

                                <td class="text-end">
                                    @detalle.PrecioUnitario.ToString("C2")
                                </td>

                                <td class="text-end fw-semibold">
                                    @subtotal.ToString("C2")
                                </td>

                            </tr>

                            numeroLinea++;
                        }

                    </tbody>

                    <tfoot>

                        <tr>

                            <th colspan="4"
                                class="text-end">

                                TOTAL

                            </th>

                            <th class="text-end">

                                @total.ToString("C2")

                            </th>

                        </tr>

                    </tfoot>

                </table>

            </div>

        </div>

    </div>

</div>