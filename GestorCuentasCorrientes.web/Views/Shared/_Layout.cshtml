@using Microsoft.AspNetCore.Identity
@using GestorCuentasCorrientes.web.Models
@inject SignInManager<Usuario> SignInManager
@inject UserManager<Usuario> UserManager

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Gestor de Cuentas</title>

    <script type="importmap"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/GestorCuentasCorrientes.web.styles.css" asp-append-version="true" />
</head>

<body class="bg-light">

    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
            <div class="container">

                <!-- Marca -->
                <a class="navbar-brand fw-bold"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="Index">
                    Gestor de Cuentas
                </a>

                <!-- Botón responsive -->
                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#navbarPrincipal"
                        aria-controls="navbarPrincipal"
                        aria-expanded="false"
                        aria-label="Mostrar navegación">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarPrincipal">

                    @if (SignInManager.IsSignedIn(User))
                    {
                        <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                            <!-- Inicio -->
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-area=""
                                   asp-controller="Home"
                                   asp-action="Index">
                                    Inicio
                                </a>
                            </li>

                            <!-- Cuentas Corrientes -->
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-area=""
                                   asp-controller="Clientes"
                                   asp-action="Index">
                                    Cuentas Corrientes
                                </a>
                            </li>

                            <!-- Presupuestos -->
                            <li class="nav-item">
                                <span class="nav-link text-white-50">
                                    Presupuestos
                                    <span class="badge bg-secondary ms-1">
                                        Próximamente
                                    </span>
                                </span>
                            </li>

                        </ul>
                    }

                    <!-- Login / usuario -->
                    <partial name="_LoginPartial" />

                </div>
            </div>
        </nav>
    </header>


    <!-- Contenido principal -->
    <main role="main">
        <div class="container py-4">
            @RenderBody()
        </div>
    </main>


    <!-- Footer -->
    <footer class="border-top bg-white text-muted mt-5">
        <div class="container py-3 text-center">
            <small>
                © 2026 - Gestor de Cuentas
            </small>
        </div>
    </footer>


    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>