@using GestorCuentasCorrientes.web.Models.ViewModels
@model ClienteDetalleVm

@{
    ViewData["Title"] = "Detalles del Cliente";

    var saldoClase = Model.SaldoActual > 0 ? "saldo-box--debe"
                   : Model.SaldoActual == 0 ? "saldo-box--cero"
                   : "saldo-box--favor";
}

<div class="container-fluid px-0">
    <div class="row">
        <div class="col-xl-10 offset-xl-1">

            <!-- Encabezado -->
            <div class="d-flex align-items-center mb-4">

                <div class="page-header-icon me-3">
                    <i class="bi bi-person-vcard"></i>
                </div>

                <div>
                    <h1 class="h2 fw-bold mb-1 page-title">@ViewData["Title"]</h1>

                    <div class="d-flex align-items-center gap-2">
                        <span class="text-muted">@Model.Cliente.RazonSocial</span>

                        @if (Model.Cliente.Activo)
                        {
                            <span class="status-pill status-pill--active">Activo</span>
                        }
                        else
                        {
                            <span class="status-pill status-pill--inactive">Inactivo</span>
                        }
                    </div>
                </div>

            </div>

            <!-- DATOS DEL CLIENTE -->
            <div class="card border-0 shadow-sm section-card mb-4">

                <div class="card-header">
                    <h2 class="section-title">
                        <i class="bi bi-info-circle"></i>
                        Datos del cliente
                    </h2>
                </div>

                <div class="card-body p-4">

                    <div class="row g-4">

                        <!-- Razón Social -->
                        <div class="col-md-6">
                            <div class="info-label">@Html.DisplayNameFor(model => model.Cliente.RazonSocial)</div>
                            <p class="info-value info-value-lg">
                                @Html.DisplayFor(model => model.Cliente.RazonSocial)
                            </p>
                        </div>

                        <!-- CUIT/DNI -->
                        <div class="col-md-6">
                            <div class="info-label">@Html.DisplayNameFor(model => model.Cliente.CuitDni)</div>
                            <p class="info-value info-value-lg">
                                @Html.DisplayFor(model => model.Cliente.CuitDni)
                            </p>
                        </div>

                        <!-- Localidad -->
                        <div class="col-md-6">
                            <div class="info-label">@Html.DisplayNameFor(model => model.Cliente.Localidad)</div>
                            <p class="info-value">
                                @Html.DisplayFor(model => model.Cliente.Localidad.Nombre)
                            </p>
                        </div>

                        <!-- Provincia -->
                        <div class="col-md-6">
                            <div class="info-label">Provincia</div>
                            <p class="info-value">
                                @Html.DisplayFor(model => model.Cliente.Localidad.Provincia)
                            </p>
                        </div>

                        <!-- Dirección -->
                        <div class="col-md-12">
                            <div class="info-label">@Html.DisplayNameFor(model => model.Cliente.Direccion)</div>
                            <p class="info-value">
                                @Html.DisplayFor(model => model.Cliente.Direccion)
                            </p>
                        </div>

                        <!-- Teléfono -->
                        <div class="col-md-6">
                            <div class="info-label">@Html.DisplayNameFor(model => model.Cliente.Telefono)</div>
                            <p class="info-value">
                                @Html.DisplayFor(model => model.Cliente.Telefono)
                            </p>
                        </div>

                        <!-- Email -->
                        <div class="col-md-6">
                            <div class="info-label">@Html.DisplayNameFor(model => model.Cliente.Email)</div>
                            <p class="info-value">
                                @if (!string.IsNullOrEmpty(Model.Cliente.Email))
                                {
                                    <a href="mailto:@Model.Cliente.Email">@Model.Cliente.Email</a>
                                }
                            </p>
                        </div>

                        <!-- Fecha de Alta -->
                        <div class="col-md-6">
                            <div class="info-label">@Html.DisplayNameFor(model => model.Cliente.FechaAlta)</div>
                            <p class="info-value">
                                @Html.DisplayFor(model => model.Cliente.FechaAlta, "{0:dd/MM/yyyy HH:mm}")
                            </p>
                        </div>

                        <!-- Estado -->
                        <div class="col-md-6">
                            <div class="info-label">@Html.DisplayNameFor(model => model.Cliente.Activo)</div>
                            <p class="info-value">
                                @if (Model.Cliente.Activo)
                                {
                                    <span class="status-pill status-pill--active">Activo</span>
                                }
                                else
                                {
                                    <span class="status-pill status-pill--inactive">Inactivo</span>
                                }
                            </p>
                        </div>

                    </div>

                </div>

            </div>

            <!-- SALDO ACTUAL - Destacado -->
            <div class="saldo-box @saldoClase mb-4" role="alert">

                <div class="saldo-label">Saldo Cuenta Corriente</div>

                <p class="saldo-amount">
                    @Model.SaldoActual.ToString("C")
                </p>

                <small>
                    @if (Model.SaldoActual > 0)
                    {
                        <span>El cliente debe esta cantidad</span>
                    }
                    else if (Model.SaldoActual == 0)
                    {
                        <span>Sin deuda</span>
                    }
                    else
                    {
                        <span>Cliente tiene a favor esta cantidad</span>
                    }
                </small>

            </div>

            <!-- MOVIMIENTOS -->
            <div class="card border-0 shadow-sm section-card mb-4">

                <div class="card-header d-flex justify-content-between align-items-center">

                    <h2 class="section-title">
                        <i class="bi bi-arrow-left-right"></i>
                        Movimientos
                    </h2>

                    <a asp-controller="Movimientos" asp-action="Create" asp-route-clienteId="@Model.Cliente.Id" class="btn btn-sm btn-success px-3">
                        <i class="bi bi-plus-circle me-1"></i> Nuevo Movimiento
                    </a>

                </div>

                <div class="card-body p-0">

                    @if (Model.Movimientos.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-products table-movs align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th class="px-4 py-3">Fecha</th>
                                        <th class="px-4 py-3">Tipo</th>
                                        <th class="px-4 py-3">Comprobante</th>
                                        <th class="px-4 py-3 text-end">Importe</th>
                                        <th class="px-4 py-3 text-end">Saldo Acum.</th>
                                        <th class="px-4 py-3"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var mov in Model.Movimientos)
                                    {
                                        <tr class="@(mov.Anulado ? "row-anulado" : "")">
                                            <td class="px-4 py-3">@mov.Fecha.ToString("dd/MM/yyyy")</td>
                                            <td class="px-4 py-3">
                                                @mov.TipoMovimientoNombre
                                                @if (mov.Anulado)
                                                {
                                                    <span class="badge bg-warning text-dark ms-2">Corregido</span>
                                                }
                                            </td>
                                            <td class="px-4 py-3">@mov.NumeroComprobante</td>
                                            <td class="px-4 py-3 text-end">
                                                @if (mov.Signo > 0)
                                                {
                                                    <span class="amount-plus">+@mov.Importe.ToString("N2")</span>
                                                }
                                                else
                                                {
                                                    <span class="amount-minus">-@mov.Importe.ToString("N2")</span>
                                                }
                                            </td>
                                            <td class="px-4 py-3 text-end">
                                                <strong>@mov.SaldoAcumulado.ToString("N2")</strong>
                                            </td>
                                            <td class="px-4 py-3 text-end">
                                                @if (mov.ComprobanteId.HasValue)
                                                {
                                                    <a asp-controller="Movimientos" asp-action="VerComprobante" asp-route-id="@mov.ComprobanteId.Value" target="_blank" class="btn btn-sm btn-outline-primary" title="Ver comprobante">
                                                        <i class="bi bi-file-pdf"></i> Ver
                                                    </a>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info m-4" role="alert">
                            <i class="bi bi-info-circle me-2"></i> No hay movimientos registrados para este cliente.
                        </div>
                    }

                </div>

            </div>

            <!-- Botones de acción -->
            <div class="d-flex flex-column flex-sm-row gap-2">
                <a asp-action="Edit" asp-route-id="@Model.Cliente.Id" class="btn btn-primary px-4">
                    <i class="bi bi-pencil me-1"></i> Editar
                </a>
                <a asp-action="Index" class="btn btn-outline-secondary px-4">
                    <i class="bi bi-arrow-left me-1"></i> Volver a Lista
                </a>
            </div>

        </div>
    </div>
</div>