@model List<Cliente>

@{
    ViewData["Title"] = "Clientes";
}

<div class="container-fluid px-0">

    <!-- Encabezado -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4">

        <div class="d-flex align-items-center">

            <div class="page-header-icon me-3">
                <i class="bi bi-people"></i>
            </div>

            <div>
                <h1 class="h2 fw-bold mb-1 page-title">
                    Clientes
                </h1>

                <p class="text-muted mb-0">
                    Administración de clientes y cuentas corrientes.
                </p>
            </div>

        </div>

        <div class="mt-3 mt-md-0">
            <a asp-action="Create"
               class="btn btn-primary px-4 shadow-sm">
                <i class="bi bi-plus-circle me-1"></i>
                Nuevo Cliente
            </a>
        </div>

    </div>


    <!-- Filtros -->
    <div class="card border-0 shadow-sm mb-4 surface-card filter-card">

        <div class="card-body p-4">

            <div class="d-flex align-items-center mb-3">

                <div class="filter-icon me-2">
                    <i class="bi bi-funnel fs-5"></i>
                </div>

                <div>
                    <h2 class="h6 fw-bold mb-0">
                        Buscar clientes
                    </h2>

                    <small class="text-muted">
                        Utilizá los filtros para encontrar un cliente.
                    </small>
                </div>

            </div>


            <form method="get" class="row g-3">

                <!-- Búsqueda -->
                <div class="col-lg-4">

                    <div class="form-floating">

                        <input type="text"
                               class="form-control"
                               id="searchTerm"
                               name="searchTerm"
                               placeholder="Buscar..."
                               value="@ViewBag.SearchTerm">

                        <label for="searchTerm">
                            Razón Social o CUIT/DNI
                        </label>

                    </div>

                </div>


                <!-- Localidad -->
                <div class="col-lg-3">

                    <div class="form-floating">

                        <select class="form-select"
                                id="localidadId"
                                name="localidadId">

                            <option value="">
                                -- Todas las Localidades --
                            </option>

                            @foreach (var item in (SelectList)ViewBag.Localidades)
                            {
                                <option value="@item.Value"
                                        selected="@item.Selected">
                                    @item.Text
                                </option>
                            }

                        </select>

                        <label for="localidadId">
                            Localidad
                        </label>

                    </div>

                </div>


                <!-- Estado -->
                <div class="col-lg-3">

                    <div class="form-floating">

                        <select class="form-select"
                                id="estado"
                                name="estado">

                            <option value="">
                                -- Todos los Estados --
                            </option>

                            <option value="1"
                                    selected="@(ViewBag.Estado == 1)">
                                Activos
                            </option>

                            <option value="0"
                                    selected="@(ViewBag.Estado == 0)">
                                Inactivos
                            </option>

                        </select>

                        <label for="estado">
                            Estado
                        </label>

                    </div>

                </div>


                <!-- Botones -->
                <div class="col-lg-2 d-flex align-items-center gap-2 filter-actions">

                    <button type="submit"
                            class="btn btn-primary flex-grow-1">

                        <i class="bi bi-search me-1"></i>
                        Buscar

                    </button>

                    <a href="@Url.Action("Index")"
                       class="btn btn-outline-secondary"
                       title="Limpiar filtros">

                        <i class="bi bi-arrow-clockwise"></i>

                    </a>

                </div>

            </form>

        </div>

    </div>


    <!-- Tabla -->
    <div class="card border-0 shadow-sm surface-card">

        <div class="card-body p-0">

            @if (Model.Count > 0)
            {
                <div class="table-responsive">

                    <table class="table table-products align-middle mb-0">

                        <thead>

                            <tr>

                                <th class="px-4 py-3">
                                    Razón Social
                                </th>

                                <th class="px-4 py-3">
                                    Localidad
                                </th>

                                <th class="px-4 py-3">
                                    CUIT/DNI
                                </th>

                                <th class="px-4 py-3">
                                    Estado
                                </th>

                                <th class="px-4 py-3 text-end">
                                    Acciones
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var item in Model)
                            {
                                <tr class="@(item.Activo ? "" : "row-inactive")">

                                    <!-- Razón Social -->
                                    <td class="px-4 py-3">

                                        <div class="d-flex align-items-center">

                                            <div class="cliente-avatar me-3">
                                                <i class="bi bi-person"></i>
                                            </div>

                                            <div>

                                                <div class="cliente-nombre">
                                                    @item.RazonSocial
                                                </div>

                                                @if (!string.IsNullOrWhiteSpace(item.Email))
                                                {
                                                    <div class="cliente-email">
                                                        @item.Email
                                                    </div>
                                                }

                                            </div>

                                        </div>

                                    </td>


                                    <!-- Localidad -->
                                    <td class="px-4 py-3">
                                        @item.Localidad?.Nombre
                                    </td>


                                    <!-- CUIT/DNI -->
                                    <td class="px-4 py-3 text-nowrap">
                                        @if (!string.IsNullOrWhiteSpace(item.CuitDni))
                                        {
                                            <span>
                                                @item.CuitDni
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted fst-italic">
                                                Sin informar
                                            </span>
                                        }
                                    </td>


                                    <!-- Estado -->
                                    <td class="px-4 py-3">

                                        @if (item.Activo)
                                        {
                                            <span class="status-pill status-pill--active">
                                                Activo
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="status-pill status-pill--inactive">
                                                Inactivo
                                            </span>
                                        }

                                    </td>


                                    <!-- Acciones -->
                                    <td class="px-4 py-3">

                                        <div class="action-buttons justify-content-end">

                                            <a asp-action="Details"
                                               asp-route-id="@item.Id"
                                               class="btn btn-sm btn-outline-primary"
                                               title="Ver cliente">

                                                <i class="bi bi-eye"></i>
                                                <span class="d-none d-xl-inline ms-1">
                                                    Ver
                                                </span>

                                            </a>


                                            <a asp-action="Edit"
                                               asp-route-id="@item.Id"
                                               class="btn btn-sm btn-outline-secondary"
                                               title="Editar cliente">

                                                <i class="bi bi-pencil"></i>
                                                <span class="d-none d-xl-inline ms-1">
                                                    Editar
                                                </span>

                                            </a>


                                            @if (User.IsInRole("Admin"))
                                            {
                                                <form method="post"
                                                      asp-action="CambiarEstado"
                                                      asp-route-id="@item.Id"
                                                      style="display: inline;"
                                                      onsubmit="return confirm('¿Está seguro de cambiar el estado?');">

                                                    @if (item.Activo)
                                                    {
                                                        <button type="submit"
                                                                class="btn btn-sm btn-outline-danger"
                                                                title="Desactivar cliente">

                                                            <i class="bi bi-x-circle"></i>

                                                            <span class="d-none d-xl-inline ms-1">
                                                                Desactivar
                                                            </span>

                                                        </button>
                                                    }
                                                    else
                                                    {
                                                        <button type="submit"
                                                                class="btn btn-sm btn-outline-success"
                                                                title="Activar cliente">

                                                            <i class="bi bi-check-circle"></i>

                                                            <span class="d-none d-xl-inline ms-1">
                                                                Activar
                                                            </span>

                                                        </button>
                                                    }

                                                </form>
                                            }

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="empty-state">

                    <div class="empty-state-icon">
                        <i class="bi bi-people"></i>
                    </div>

                    <h3 class="h5">
                        No se encontraron clientes
                    </h3>

                    <p class="text-muted mb-0">
                        No existen clientes que cumplan con los criterios
                        de búsqueda seleccionados.
                    </p>

                </div>
            }

        </div>

    </div>

</div>